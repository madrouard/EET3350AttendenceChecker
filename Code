#include <Keypad.h>

const uint8_t LEDS = 12;
const uint8_t ROWS = 4;
const uint8_t COLS = 4;

char keys[ROWS][COLS] = {
  { '1', '2', '3', 'A' },
  { '4', '5', '6', 'B' },
  { '7', '8', '9', 'C' },
  { '*', '0', '#', 'D' }
};

// Pins connected to LED1, LED2, LED3, ...LED12
uint8_t ledPins[LEDS] = { 9, 6, 3,};
uint8_t rowPins[ROWS] = { 26, 22, 21, 20 }; // Pins connected to R1, R2, R3, R4
uint8_t colPins[COLS] = { 19, 18, 17, 16 }; // Pins connected to C1, C2, C3, C4
char id[20] = "";
const String Codes[3] = {"1234","AB12","ABCD"};
bool found = false;

Keypad keypad = Keypad(makeKeymap(keys), rowPins, colPins, ROWS, COLS);

void setup() {
  for (uint8_t l = 0; l < LEDS; l++) {
    pinMode(ledPins[l], OUTPUT);
    digitalWrite(ledPins[l], LOW);
  }
}

void loop() {
  char key = keypad.getKey();

  if (key != NO_KEY && key != '#') {
      digitalWrite(ledPins[0], HIGH);
      delay(50);
      digitalWrite(ledPins[0], LOW);

  }

  if (key == '*'){
    id[0] = '\0';
  }
  else if (key == '#'){
    for(int i = 0; i < sizeof(Codes); i++)
        {
          if (id == Codes[i] && id != NULL && id[0] != '\0')
          {
            found = true;
          }
        }

        if (found)
        {
            digitalWrite(ledPins[1], HIGH);
            delay(500);
            digitalWrite(ledPins[1], LOW);

            id[0] = '\0';
            found = false;
        }
        else
        {
            digitalWrite(ledPins[2], HIGH);
            delay(500);
            digitalWrite(ledPins[2], LOW);
            id[0] = '\0';
        }
  }
  else{
    size_t len = strlen(id);
    if (len < sizeof(id) - 1) {
        id[len] = key;       // Overwrite old '\0'
        id[len + 1] = '\0'; // Add new '\0'
    }
    if (len > 4 && found == false) {
        digitalWrite(ledPins[2], HIGH);
        delay(500);
        digitalWrite(ledPins[2], LOW);
        id[0] = '\0';
        found = false;
    }
    printf("%s\n", id);
  }

  

  delay(10);
}
